{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Learning Profile 1.0.0",
  "type": "object",
  "required": ["format", "schema_version", "exported_at", "producer", "learner", "coverage", "summary", "learning_preferences", "knowledge_points", "recurring_difficulties", "reviews", "lessons", "methodology", "excluded", "warnings"],
  "properties": {
    "format": {"const": "echo.learning-profile"},
    "schema_version": {"const": "1.0.0"},
    "exported_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "object", "required": ["name", "version"], "properties": {"name": {"const": "Echo"}, "version": {"type": "string"}}},
    "learner": {
      "type": "object", "required": ["local_id", "profile"],
      "properties": {"local_id": {"type": ["string", "null"]}, "profile": {
        "type": "object", "properties": {
          "name": {"type": "string"}, "nickname": {"type": "string"}, "username": {"type": "string"},
          "age": {"type": "number", "minimum": 0, "maximum": 150},
          "hobbies": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/strings"}]}
        }
      }}
    },
    "coverage": {"type": "object", "required": ["scope", "retained_lessons", "lesson_storage_limit", "active_lesson_included", "per_question_history_available"], "properties": {
      "scope": {"const": "saved_history_only"}, "retained_lessons": {"$ref": "#/$defs/count"},
      "lesson_storage_limit": {"const": 50}, "active_lesson_included": {"const": false}, "per_question_history_available": {"const": false}
    }},
    "summary": {"type": "object", "required": ["knowledge_count", "review_record_count", "strength_ids", "weakness_ids", "developing_ids"], "properties": {
      "knowledge_count": {"$ref": "#/$defs/count"}, "review_record_count": {"$ref": "#/$defs/count"},
      "strength_ids": {"$ref": "#/$defs/strings"}, "weakness_ids": {"$ref": "#/$defs/strings"}, "developing_ids": {"$ref": "#/$defs/strings"}
    }},
    "learning_preferences": {"type": "object", "required": ["style", "sample_topics", "again_rate", "clear_rate", "source"], "properties": {
      "style": {"enum": ["insufficient_data", "needs_examples", "steady"]}, "sample_topics": {"$ref": "#/$defs/count"},
      "again_rate": {"$ref": "#/$defs/ratio"}, "clear_rate": {"$ref": "#/$defs/ratio"}, "source": {"const": "latest_review_self_reports"}
    }},
    "knowledge_points": {"type": "array", "items": {"$ref": "#/$defs/knowledge"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "lessons": {"type": "array", "items": {"$ref": "#/$defs/lesson"}},
    "recurring_difficulties": {"type": "array", "items": {"type": "object", "required": ["knowledge_id", "topic", "affected_lesson_count", "lesson_ids", "basis"], "properties": {
      "knowledge_id": {"type": "string"}, "topic": {"type": "string"}, "affected_lesson_count": {"type": "integer", "minimum": 2},
      "lesson_ids": {"$ref": "#/$defs/strings"}, "basis": {"const": "difficulty_in_multiple_saved_lessons"}
    }}},
    "methodology": {"type": "object", "required": ["version", "mastery_is_exam_score", "states_are", "repeat_count_is", "subject_source", "missing_values"], "properties": {
      "version": {"const": "1.0.0"}, "mastery_is_exam_score": {"const": false},
      "states_are": {"const": "rule_based_indicators_not_ability_certification"},
      "repeat_count_is": {"const": "distinct_saved_lessons_with_difficulty"},
      "subject_source": {"const": "course_title_prefix"}, "missing_values": {"const": "null"}
    }},
    "excluded": {"$ref": "#/$defs/strings"}, "warnings": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "strings": {"type": "array", "items": {"type": "string"}},
    "ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "date": {"type": ["string", "null"], "format": "date-time"},
    "subject": {"type": ["string", "null"]},
    "knowledge": {"type": "object", "required": ["id", "topic", "subject", "observations", "review", "state", "reasons", "latest_mastery", "difficulty_lesson_ids"], "properties": {
      "id": {"type": "string"}, "topic": {"type": "string"}, "subject": {"$ref": "#/$defs/subject"},
      "state": {"enum": ["strength", "weakness", "developing", "unknown"]},
      "reasons": {"$ref": "#/$defs/strings"}, "latest_mastery": {"$ref": "#/$defs/ratio"},
      "difficulty_lesson_ids": {"$ref": "#/$defs/strings"},
      "review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/review"}]},
      "observations": {"type": "array", "items": {"type": "object", "required": ["lesson_id", "observed_at", "mastery", "status", "source"], "properties": {
        "lesson_id": {"type": "string"}, "observed_at": {"$ref": "#/$defs/date"}, "mastery": {"$ref": "#/$defs/ratio"},
        "status": {"type": "string"}, "source": {"const": "lesson_summary"}
      }}}
    }},
    "review": {"type": "object", "required": ["id", "knowledge_id", "topic", "missing", "reason", "source", "reviewed", "review_sessions", "last_result", "level", "recorded_at", "last_reviewed_at", "next_review_at"], "properties": {
      "id": {"type": "string"}, "knowledge_id": {"type": "string"}, "topic": {"type": "string"}, "missing": {"type": "string"}, "reason": {"type": "string"}, "source": {"type": "string"},
      "reviewed": {"type": "boolean"}, "review_sessions": {"$ref": "#/$defs/count"}, "last_result": {"enum": ["again", "fuzzy", "clear", null]},
      "level": {"$ref": "#/$defs/count"}, "recorded_at": {"$ref": "#/$defs/date"}, "last_reviewed_at": {"$ref": "#/$defs/date"}, "next_review_at": {"$ref": "#/$defs/date"}
    }},
    "lesson": {"type": "object", "required": ["id", "title", "subject", "ended_at", "duration_seconds", "summary", "knowledge_ids", "quiz"], "properties": {
      "id": {"type": "string"}, "title": {"type": "string"}, "subject": {"$ref": "#/$defs/subject"}, "ended_at": {"$ref": "#/$defs/date"},
      "duration_seconds": {"type": "number", "minimum": 0}, "summary": {"type": "string"}, "knowledge_ids": {"$ref": "#/$defs/strings"},
      "quiz": {"type": "object", "required": ["total", "correct", "accuracy"], "properties": {"total": {"$ref": "#/$defs/count"}, "correct": {"$ref": "#/$defs/count"}, "accuracy": {"$ref": "#/$defs/ratio"}}}
    }}
  }
}
