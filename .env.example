# 复制为 .env 后填写
DEEPSEEK_API_KEY=
# system: 抓电脑正在播放的声音（腾讯会议/Zoom/B站/录播课，戴耳机也行）
# mic:    麦克风（ECHO_AUDIO_DEVICE 可填设备序号或名称片段）
# demo:   回放 echo/backend/demo_lesson.txt（离线兜底）
ECHO_SOURCE=system
ECHO_AUDIO_DEVICE=
# Whisper 模型：small（默认，CPU 实时）/ medium（更准，更慢）
ECHO_WHISPER_MODEL=small
# 「圈一下问 AI」视觉模型（可选，填了用 Qwen-VL，更会看屏幕/公式；不填退回 DeepSeek）
DASHSCOPE_API_KEY=
ECHO_QWEN_VL_MODEL=qwen-vl-plus
