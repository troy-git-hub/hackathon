# 复制为 .env 后填写。也可以启动后右键托盘 → 设置… 里选厂商再填。
# 文本模型：deepseek / qwen / kimi / zhipu / silicon / openai / groq / ollama / custom
ECHO_LLM_PROVIDER=deepseek
ECHO_LLM_API_KEY=
ECHO_LLM_MODEL=deepseek-flash
ECHO_LLM_BASE_URL=https://api.deepseek.com
# 视觉模型（圈一下问 AI）：same = 跟文本同一家；或单独选 qwen / openai / zhipu / silicon / custom
ECHO_VISION_PROVIDER=same
ECHO_VISION_API_KEY=
ECHO_VISION_MODEL=
# 下面两个是旧字段，设置里选了 DeepSeek / 千问后仍会写一份，老配置不用改也能用
DEEPSEEK_API_KEY=
# system: 抓电脑正在播放的声音（腾讯会议/Zoom/B站/录播课，戴耳机也行）
# mic:    麦克风（ECHO_AUDIO_DEVICE 可填设备序号或名称片段）
ECHO_SOURCE=system
ECHO_AUDIO_DEVICE=
# Whisper 模型：small（默认，CPU 实时）/ medium（更准，更慢）
ECHO_WHISPER_MODEL=small
# Whisper CPU 线程数：默认 4。机器内存紧张报 mkl_malloc 内存分配失败时降到 2 或 1
ECHO_WHISPER_THREADS=4
# 「圈一下问 AI」旧的百炼 key（选填）。没设 ECHO_VISION_PROVIDER 时，填了就用 Qwen-VL
DASHSCOPE_API_KEY=
ECHO_QWEN_VL_MODEL=qwen-vl-plus
