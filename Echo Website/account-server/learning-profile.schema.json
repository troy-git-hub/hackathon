{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echo Personal Learning Profile 2.0.0",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "exported_at",
    "producer",
    "selected_sections",
    "coverage",
    "methodology",
    "excluded",
    "warnings"
  ],
  "properties": {
    "format": {
      "const": "echo.learning-profile"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "Echo"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "learner": {
      "type": "object",
      "required": [
        "local_id",
        "profile"
      ],
      "properties": {
        "local_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "nickname": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "age": {
              "type": "number",
              "minimum": 0,
              "maximum": 150
            },
            "hobbies": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/strings"
                }
              ]
            }
          }
        }
      }
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "learning_preferences": {
      "type": "object",
      "required": [
        "style",
        "sample_topics",
        "again_rate",
        "clear_rate",
        "source"
      ],
      "properties": {
        "style": {
          "enum": [
            "insufficient_data",
            "needs_examples",
            "steady"
          ]
        },
        "sample_topics": {
          "$ref": "#/$defs/count"
        },
        "again_rate": {
          "$ref": "#/$defs/ratio"
        },
        "clear_rate": {
          "$ref": "#/$defs/ratio"
        },
        "source": {
          "const": "latest_review_self_reports"
        }
      }
    },
    "methodology": {
      "type": "object",
      "required": [
        "version",
        "mastery_is_exam_score",
        "states_are",
        "repeat_count_is",
        "subject_source",
        "missing_values"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "mastery_is_exam_score": {
          "const": false
        },
        "states_are": {
          "const": "rule_based_indicators_not_ability_certification"
        },
        "repeat_count_is": {
          "const": "distinct_saved_lessons_with_difficulty"
        },
        "subject_source": {
          "const": "course_title_prefix"
        },
        "missing_values": {
          "const": "null"
        }
      }
    },
    "excluded": {
      "$ref": "#/$defs/strings"
    },
    "warnings": {
      "$ref": "#/$defs/strings"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "selected_sections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "profile",
          "mastery",
          "difficulties",
          "reviews",
          "preferences"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "scope",
        "saved_lesson_count",
        "lesson_storage_limit",
        "active_lesson_included",
        "per_question_history_available",
        "lesson_details_included"
      ],
      "properties": {
        "scope": {
          "const": "personal_aggregate"
        },
        "saved_lesson_count": {
          "$ref": "#/$defs/count"
        },
        "lesson_storage_limit": {
          "const": 50
        },
        "active_lesson_included": {
          "const": false
        },
        "per_question_history_available": {
          "const": false
        },
        "lesson_details_included": {
          "const": false
        }
      }
    },
    "difficulties": {
      "type": "object",
      "required": [
        "weaknesses",
        "recurring"
      ],
      "properties": {
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge"
          }
        },
        "recurring": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "knowledge_id",
              "topic",
              "affected_lesson_count",
              "basis"
            ],
            "properties": {
              "knowledge_id": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "affected_lesson_count": {
                "type": "integer",
                "minimum": 2
              },
              "basis": {
                "const": "difficulty_in_multiple_saved_lessons"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "knowledge": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "subject",
        "state",
        "reasons",
        "latest_mastery",
        "learning_sessions",
        "difficulty_sessions"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "state": {
          "enum": [
            "strength",
            "weakness",
            "developing",
            "unknown"
          ]
        },
        "reasons": {
          "$ref": "#/$defs/strings"
        },
        "latest_mastery": {
          "$ref": "#/$defs/ratio"
        },
        "learning_sessions": {
          "$ref": "#/$defs/count"
        },
        "difficulty_sessions": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "knowledge_id",
        "topic",
        "missing",
        "reason",
        "source",
        "reviewed",
        "review_sessions",
        "last_result",
        "level",
        "recorded_at",
        "last_reviewed_at",
        "next_review_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "knowledge_id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "missing": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "review_sessions": {
          "$ref": "#/$defs/count"
        },
        "last_result": {
          "enum": [
            "again",
            "fuzzy",
            "clear",
            null
          ]
        },
        "level": {
          "$ref": "#/$defs/count"
        },
        "recorded_at": {
          "$ref": "#/$defs/date"
        },
        "last_reviewed_at": {
          "$ref": "#/$defs/date"
        },
        "next_review_at": {
          "$ref": "#/$defs/date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_sections": {
            "contains": {
              "const": "profile"
            }
          }
        }
      },
      "then": {
        "required": [
          "learner"
        ]
      },
      "else": {
        "not": {
          "required": [
            "learner"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_sections": {
            "contains": {
              "const": "mastery"
            }
          }
        }
      },
      "then": {
        "required": [
          "knowledge_points"
        ]
      },
      "else": {
        "not": {
          "required": [
            "knowledge_points"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_sections": {
            "contains": {
              "const": "difficulties"
            }
          }
        }
      },
      "then": {
        "required": [
          "difficulties"
        ]
      },
      "else": {
        "not": {
          "required": [
            "difficulties"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_sections": {
            "contains": {
              "const": "reviews"
            }
          }
        }
      },
      "then": {
        "required": [
          "reviews"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reviews"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_sections": {
            "contains": {
              "const": "preferences"
            }
          }
        }
      },
      "then": {
        "required": [
          "learning_preferences"
        ]
      },
      "else": {
        "not": {
          "required": [
            "learning_preferences"
          ]
        }
      }
    }
  ]
}
